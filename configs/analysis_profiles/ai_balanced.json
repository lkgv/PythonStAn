  "max_star_expand_alts": 4,
  "max_dict_parts": 20,
  "max_dict_key_const_strs": 10,
  "max_dict_key_const_ints": 10,
  "max_dict_key_tuple_len": 4,
  "max_dict_key_tuple_alts": 2,
  "enable_dict_identity_keys": true,
