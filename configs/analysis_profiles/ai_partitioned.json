{
  "pta_analysis_name": "kcfa",
  "context_policy": "inherit",
  "log_level": "INFO",
  "max_iterations": 500,
  "max_stmt_visits": 100,
  "max_recursion_depth": 5,
  "strict_exceptions": false,
  "max_addr_set_size": 100,
  "max_field_keys": 20,
  "max_const_strings": 20,
  "max_ho_tokens": 40,
  "enable_narrowing": true,
  "narrowing_iterations": 2,
  "enable_value_partition": true,
  "max_value_partitions": 8,
  "value_partition_str_cap": 8,
  "max_const_ints": 4,
  "max_tuple_len_exact": 8,
  "max_tuple_alts": 4,
  "max_star_expand_len": 8,
  "max_star_expand_alts": 4,
  "max_dict_parts": 20,
  "max_dict_key_const_strs": 10,
  "max_dict_key_const_ints": 10,
  "max_dict_key_tuple_len": 4,
  "max_dict_key_tuple_alts": 2,
  "enable_dict_identity_keys": true,
  "max_dict_identity_keys": 10,
  "solver_options": {
    "loop_unroll": 8,
    "enable_trace_partitioning": true,
    "infer_merge_points": true,
    "max_traces_per_block": 16,
    "max_total_traces": 128,
    "merge_points": [],
    "loop_iters": {}
  },
  "type": "ai analysis"
}
